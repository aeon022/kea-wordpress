<div class="dan-sync__cloud">
  <div class="dan-sync__icon-box">
    {% if content.content.cloud_logo.url %}
      <img class="dan-sync__cloud-logo" src="{{ content.content.cloud_logo.url|escape('html_attr') }}" alt="Logo">
    {% else %}
      <svg class="dan-sync__cloud-icon" width="28" height="28" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 12C0 14.7614 2.23858 17 5 17H15C17.7614 17 20 14.7614 20 12C20 9.23858 17.7614 7 15 7C15 4.23858 12.7614 2 10 2C7.23858 2 5 4.23858 5 7C2.23858 7 0 9.23858 0 12Z" fill="currentColor"/>
        <path d="M14.5 7V7.5H15C17.4853 7.5 19.5 9.51472 19.5 12C19.5 14.4853 17.4853 16.5 15 16.5H5C2.51472 16.5 0.5 14.4853 0.5 12C0.5 9.51472 2.51472 7.5 5 7.5H5.5V7C5.5 4.51472 7.51472 2.5 10 2.5C12.4853 2.5 14.5 4.51472 14.5 7Z" stroke="black" stroke-opacity="0.2"/>
      </svg>
    {% endif %}
  </div>

  {% for i in 0..3 %}
    <div class="dan-sync__ripple" style="--i:{{ i }}"></div>
  {% endfor %}
</div>

<div class="dan-sync__line">
  <div class="dan-sync__line-base"></div>
  <div class="dan-sync__trail-mover">
    <div class="dan-sync__trail-flipper">
      <div class="dan-sync__trail">
        <div class="dan-sync__trail-line"></div>
        <div class="dan-sync__trail-dot"></div>
      </div>
    </div>
  </div>
</div>

<div class="dan-sync__badge">
  <span class="dan-sync__badge-text">{{ content.content.action_text }}</span>
  <span class="dan-sync__spinner">
    <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="5" cy="5" r="4.25" stroke="currentColor" stroke-opacity="0.2" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M5 0.75C7.34721 0.75 9.25 2.65279 9.25 5C9.25 7.34721 7.34721 9.25 5 9.25C3.82904 9.25 2.76868 8.77644 2 8.0104" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>
</div>

