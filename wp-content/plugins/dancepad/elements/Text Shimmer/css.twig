%%SELECTOR%%{
    --text-color: {{ design.shimmer.text_color }};
    --shimmer-color: {{ design.shimmer.shimmer_color }};
    --shimmer-size: {{ design.shimmer.shimmer_size.style }};

    {{ macros.typography(design.typography, globalSettings) }}
    {{ macros.spacing_margin_all(design.margin) }}
    {{ macros.background(design.background) }}
    {{ macros.borders(design.borders) }}
}
%%SELECTOR%%:not(:has(> a)),
%%SELECTOR%% > a{
    {{ macros.spacing_padding_all(design.padding) }}
}