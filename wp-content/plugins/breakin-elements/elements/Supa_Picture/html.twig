alt="{{ get_attachment_alt(content.picture.desktop_image.id) }}"{% elseif content.picture.alt == 'custom' %}alt="{{ content.picture.custom_alt }}"{% endif %} {% if content.picture.lazy_load %}loading="lazy"{% endif %} {% if content.picture.set_html_width_height %}width="{{ content.picture.width }}" height="{{ content.picture.height }}"{% endif %} >
