{% set size = content.picture.image_size |default('full') %}
{% set imageurl = attribute(content.picture.desktop_image.sizes, size).url %}
<picture class='%%UNIQUESLUG%% supa-picture'>
{% for item in content.picture.breakpoint_images %}
{% set currentBreakpoint =  item.breakpoint %}
{% set breakpointWidth = get_breakpoint_max_width(currentBreakpoint) %}
{% if currentBreakpoint != "breakpoint_base" and currentBreakpoint is not empty %}
<source media="(max-width: {{ breakpointWidth }}px)" srcset="{% if item.size %}{{ item.image.sizes[item.size].url }}{% else %}{{ item.image.url }}{% endif %}" />
{% endif %}
{% endfor %}
