%%SELECTOR%% {
  {{ macros.backgroundColor(design.container.background) }}
  perspective: {{ content.perspective.perspective.style }};
  width: {{ design.container.width.style }};
  --thickness: {{ content.perspective.thickness.style }};
  {% if content.perspective.thickness.style %}
  --trz:calc( var(--half) * var(--inv));
  {% endif %}
  {% if content.content.perspective == 'back' %}
--inv:-1;
{% endif %}
  z-index:{{ content.content.z_index }};
  {{ macros.spacing_margin_y(design.spacing) }}
}

