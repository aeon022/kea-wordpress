/* Dateipfad: wp-content/plugins/kea-breakdance-elements/elements/Reise_Match/css.twig */
{% if design.colors.background %}
%%SELECTOR%% .kea-reisematch-container {
    background-color: {{ design.colors.background }};
}
{% endif %}

{% if design.colors.border %}
%%SELECTOR%% .kea-reisematch-container {
    border-color: {{ design.colors.border }};
}
{% endif %}

{% if design.colors.text %}
%%SELECTOR%% .kea-reisematch-container {
    color: {{ design.colors.text }};
}
{% endif %}

{% if design.colors.accent %}
%%SELECTOR%% .kea-match-result-badge {
    background-color: {{ design.colors.accent }};
}
{% endif %}

/* Button Design Controls */
{% if design.button_design.bg %}
%%SELECTOR%% .kea-match-btn-primary,
%%SELECTOR%% a.kea-match-btn-primary {
    background-color: {{ design.button_design.bg }} !important;
}
{% endif %}

{% if design.button_design.bg_hover %}
%%SELECTOR%% .kea-match-btn-primary:hover,
%%SELECTOR%% a.kea-match-btn-primary:hover {
    background-color: {{ design.button_design.bg_hover }} !important;
}
{% endif %}

{% if design.button_design.text_color %}
%%SELECTOR%% .kea-match-btn-primary,
%%SELECTOR%% a.kea-match-btn-primary,
%%SELECTOR%% .kea-match-btn-primary *,
%%SELECTOR%% .kea-match-btn-primary span {
    color: {{ design.button_design.text_color }} !important;
}
{% endif %}

{% if design.button_design.text_hover %}
%%SELECTOR%% .kea-match-btn-primary:hover,
%%SELECTOR%% a.kea-match-btn-primary:hover,
%%SELECTOR%% .kea-match-btn-primary:hover *,
%%SELECTOR%% .kea-match-btn-primary:hover span {
    color: {{ design.button_design.text_hover }} !important;
}
{% endif %}

{% if design.button_design.border_color %}
%%SELECTOR%% .kea-match-btn-primary,
%%SELECTOR%% a.kea-match-btn-primary {
    border-color: {{ design.button_design.border_color }} !important;
}
{% endif %}

{% if design.button_design.radius.number %}
%%SELECTOR%% .kea-match-btn-primary,
%%SELECTOR%% a.kea-match-btn-primary {
    border-radius: {{ design.button_design.radius.number }}{{ design.button_design.radius.unit|default('px') }} !important;
}
{% endif %}
